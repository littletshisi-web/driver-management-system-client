+  align-items: flex-start;
+  text-align: left;
+  gap: 2px;
+  padding: 12px 14px;
+  background: var(--surface2);
+  border: 1.5px solid var(--border2);
+  border-radius: var(--radius);
+  cursor: pointer;
+  transition: all var(--transition);
+}
+
+.typeActive {
+  border-color: var(--accent);
+  background: var(--accent-light);
+}
+
+.typeLabel {
+  font-family: var(--font-head);
+  font-size: 13px;
+  font-weight: 700;
+  color: var(--text);
+}
+
+.typeHint {
+  font-size: 11px;
+  color: var(--text2);
+}
+
+/* ── Service checkboxes ──────────── */
+.checkGrid {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px 18px;
+}
+
+.checkItem {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  font-size: 13px;
+  color: var(--text);
+  cursor: pointer;
+}
+
+.checkItem input {
+  accent-color: var(--accent);
+  width: 15px;
+  height: 15px;
+}
+
+.loginBtn {
+  width: 100%;
+  padding: 13px;
+  background: var(--accent);
+  border: none;
+  border-radius: var(--radius);
+  color: #fff;
+  font-family: var(--font-head);
+  font-size: 14px;
+  font-weight: 700;
+  letter-spacing: 0.4px;
+  cursor: pointer;
+  transition: all var(--transition);
+  margin-top: 4px;
+}
+
+.loginBtn:hover:not(:disabled) {
+  background: var(--accent-mid);
+  transform: translateY(-1px);
+  box-shadow: 0 4px 16px rgba(30,58,95,0.3);
+}
+
+.loginBtn:disabled {
+  opacity: 0.6;
+  cursor: not-allowed;
+}
+
+.mockNotice {
+  margin-top: 20px;
+  padding: 12px 14px;
+  background: var(--surface2);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  font-size: 12px;
+  color: var(--text2);
+  line-height: 1.6;
+  text-align: center;
+  display: block;
+}
+
+.mockNotice a {
+  color: var(--accent);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.mockNotice a:hover {
+  text-decoration: underline;
+}
+
+@media (max-width: 900px) {
+  .left { display: none; }
+  .right { width: 100%; }
+  .row { flex-direction: column; gap: 0; }
+}
+
+@media (max-width: 480px) {
+  .right { padding: 32px 24px; }
+}
