+  letter-spacing: 0.8px;
+  margin-bottom: 6px;
+  font-family: var(--font-head);
+}
+
+.input, .textarea {
+  width: 100%;
+  padding: 11px 14px;
+  background: var(--surface2);
+  border: 1.5px solid var(--border2);
+  border-radius: var(--radius);
